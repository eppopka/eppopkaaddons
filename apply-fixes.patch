@@ -0,0 +1,88 @@
+package dev.eppopkaaddons.config.types
+
+import dev.eppopkaaddons.config.ConfigHolder
+import dev.eppopkaaddons.config.Savable
+import com.google.gson.JsonElement
+import com.google.gson.JsonObject
+import kotlin.math.round
+
+data class NumberRange<T : Number>(val lower: T, val upper: T)
+
+class RangeSliderSetting<T : Number>(
+    name: String,
+    defaultLower: T,
+    defaultUpper: T,
+    val min: T,
+    val max: T,
+    val step: T,
+    val suffix: String = "",
+) : ConfigHolder<NumberRange<T>>(
+    name,
+    NumberRange(
+        if (defaultLower.toDouble() <= defaultUpper.toDouble()) defaultLower else defaultUpper,
+        if (defaultLower.toDouble() <= defaultUpper.toDouble()) defaultUpper else defaultLower,
+    ),
+), Savable {
+    override fun write() = JsonObject().apply {
+        addProperty("lower", value.lower)
+        addProperty("upper", value.upper)
+    }
+
+    override fun read(element: JsonElement) {
+        if (!element.isJsonObject) return
+        val obj = element.asJsonObject
+        val lower = obj.get("lower")?.asDouble ?: return
+        val upper = obj.get("upper")?.asDouble ?: return
+        set(snapToStep(lower), snapToStep(upper))
+    }
+
+    fun set(lower: T, upper: T) {
+        value = if (lower.toDouble() <= upper.toDouble()) {
+            NumberRange(lower, upper)
+        } else {
+            NumberRange(upper, lower)
+        }
+    }
+
+    fun setLower(raw: Double) {
+        val next = snapToStep(raw.coerceAtMost(value.upper.toDouble()))
+        value = NumberRange(next, value.upper)
+    }
+
+    fun setUpper(raw: Double) {
+        val next = snapToStep(raw.coerceAtLeast(value.lower.toDouble()))
+        value = NumberRange(value.lower, next)
+    }
+
+    fun snapToStep(raw: Double): T {
+        val minD = min.toDouble()
+        val maxD = max.toDouble()
+        val stepD = step.toDouble()
+        val clamped = raw.coerceIn(minD, maxD)
+        if (stepD <= 0.0) return clamped.convertToType()
+        val steps = round((clamped - minD) / stepD)
+        return (minD + steps * stepD).coerceIn(minD, maxD).convertToType()
+    }
+
+    fun stringify(number: T): String = when (number) {
+        is Int, is Long -> number.toLong().toString()
+        else -> {
+            val decimals = step.toString().substringAfter('.', "").trimEnd('0').length
+            "%.${decimals.coerceAtMost(4)}f".format(number.toDouble())
+        }
+    }
+
+    fun progress(number: T): Float {
+        val span = max.toDouble() - min.toDouble()
+        return if (span == 0.0) 0f else ((number.toDouble() - min.toDouble()) / span).toFloat().coerceIn(0f, 1f)
+    }
+
+    @Suppress("UNCHECKED_CAST")
+    private fun Number.convertToType(): T = when (min) {
+        is Int -> toInt() as T
+        is Long -> toLong() as T
+        is Float -> toFloat() as T
+        is Double -> toDouble() as T
+        else -> this as T
+    }
+}
