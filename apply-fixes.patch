+import java.io.File
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertTrue
+
+/** Source-layout regressions; these deliberately do not start a Minecraft client. */
+class FeatureLayoutTest {
+    private val impl = File("src/main/kotlin/dev/eppopkaaddons/features/impl")
+    private fun source(path: String) = File(impl, path).readText()
+
+    @Test
+    fun movedFeaturesHaveExactlyOneSource() {
+        val files = impl.walkTopDown().filter { it.isFile && it.extension == "kt" }.toList()
+        assertEquals(listOf("general/PetDisplay.kt"),
+            files.filter { it.name == "PetDisplay.kt" }.map { it.relativeTo(impl).invariantSeparatorsPath })
+        assertEquals(listOf("dungeon/ShitterList.kt"),
+            files.filter { it.name == "ShitterList.kt" }.map { it.relativeTo(impl).invariantSeparatorsPath })
+        assertFalse(files.any { it.name == "LbTimer.kt" })
+    }
+
+    @Test
+    fun featurePackagesMatchTheirCategoryFolders() {
+        impl.walkTopDown().filter { it.isFile && it.extension == "kt" }.forEach { file ->
+            val folder = file.parentFile.relativeTo(impl).invariantSeparatorsPath.replace('/', '.')
+            val declared = Regex("""(?m)^package\s+(\S+)""").find(file.readText())?.groupValues?.get(1)
+            assertEquals("dev.eppopkaaddons.features.impl.$folder", declared, file.path)
+        }
+        assertFalse(source("general/PetDisplay.kt").contains("override val category"))
+    }
+
+    @Test
+    fun spatialGuiUsesTheSameCategoriesAsFeatureRegistration() {
+        val gui = File("src/main/kotlin/dev/eppopkaaddons/ui/clickgui/enums/SpatialCategory.kt").readText()
+        assertTrue(gui.contains(".filter { it.category == featureCategory }"))
+        assertFalse(gui.contains("assignments"))
+        assertFalse(gui.contains("simpleName"))
+        for (name in listOf("VISUAL", "QOL", "DUNGEON", "HUNTING", "GENERAL")) {
+            assertTrue(gui.contains("CategoryType.$name)"), "Missing category mapping: $name")
+        }
+    }
+
+    @Test
+    fun portraitUsesTheCardPoseAndNativeItemRendering() {
+        val pet = source("general/PetDisplay.kt")
+        assertTrue(pet.contains("ctx.pose().translate(11f, 8f)"))
+        assertTrue(pet.contains("ctx.pose().scale(1.55f, 1.55f)"))
+        assertTrue(pet.contains("ctx.item(activePetStack, 0, 0)"))
+        assertFalse(pet.contains("drawBatchedItemStack"))
+        assertFalse(pet.contains("endItemRendererBatch"))
+        // 16px native item box, scaled locally; it fits between header and bar.
+        assertTrue(8f + 16f * 1.55f < 36f)
+        assertTrue(11f + 16f * 1.55f < 51f)
+    }
+}
